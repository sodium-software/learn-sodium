{
  "name": "learn-sodium",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "La Cartilla — plataforma para aprender inglés con canciones, historias, podcast, cortometrajes y actividades.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test:e2e": "node scripts/e2e.mjs",
    "test:media": "node scripts/check-media.mjs",
    "shots": "node scripts/shoot.mjs",
    "media:generate": "python3 scripts/generate-media.py",
    "deploy": "npm run build && wrangler pages deploy --branch main",
    "dev:api": "npm run build && wrangler pages dev",
    "db:local": "wrangler d1 migrations apply learn-sodium --local && wrangler d1 execute learn-sodium --local --file seed/demo.sql",
    "admin:user": "node scripts/admin-user.mjs",
    "seed": "node scripts/seed-demo.mjs",
    "deploy:preview": "npm run build && wrangler pages deploy --branch preview"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.68.0",
    "@cloudflare/workers-types": "^5.20261110.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "wrangler": "^4.159.0"
  }
}
